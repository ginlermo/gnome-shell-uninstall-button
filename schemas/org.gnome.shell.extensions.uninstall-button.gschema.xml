<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.uninstall-button" path="/org/gnome/shell/extensions/uninstall-button/">
    <key name="confirm-before-uninstall" type="b">
      <default>true</default>
      <summary>Confirm before uninstalling</summary>
      <description>Show a confirmation dialog before removing an application.</description>
    </key>
    <key name="protected-apps" type="as">
      <default>['org.gnome.Nautilus.desktop', 'org.gnome.Settings.desktop', 'org.gnome.Software.desktop', 'org.gnome.Extensions.desktop', 'org.gnome.Console.desktop', 'org.gnome.Terminal.desktop', 'snap-store_snap-store.desktop', 'ubuntu-desktop-installer_ubuntu-desktop-installer.desktop', 'update-manager.desktop', 'software-properties-gnome.desktop']</default>
      <summary>Protected applications</summary>
      <description>Desktop file IDs that never get an Uninstall entry.</description>
    </key>
  </schema>
</schemalist>
